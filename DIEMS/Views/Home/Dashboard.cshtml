@model Dictionary<string, object>
@{
    ViewData["Title"] = "Dashboard";
}

<style>
    .glass-card {
        background: rgba(17, 25, 37, 0.6) !important;
        backdrop-filter: blur(12px) !important;
        -webkit-backdrop-filter: blur(12px) !important;
        border: 1px solid rgba(255, 255, 255, 0.08) !important;
        box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.3) !important;
        transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
    }
    .glass-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 12px 40px 0 rgba(0, 0, 0, 0.4) !important;
        border-color: rgba(255, 255, 255, 0.15) !important;
    }
    .pulse-dot {
        height: 8px;
        width: 8px;
        background-color: var(--status-red);
        border-radius: 50%;
        display: inline-block;
        margin-right: 6px;
        animation: pulse-dot-anim 1.5s infinite;
    }
    @@keyframes pulse-dot-anim {
        0% { box-shadow: 0 0 0 0 rgba(255, 59, 59, 0.7); }
        70% { box-shadow: 0 0 0 6px rgba(255, 59, 59, 0); }
        100% { box-shadow: 0 0 0 0 rgba(255, 59, 59, 0); }
    }
</style>

<!-- Critical Alert Banner -->
<div style="background:linear-gradient(135deg,rgba(255,59,59,0.12),rgba(255,78,0,0.08));border:1px solid rgba(255,59,59,0.3);border-radius:var(--radius-lg);padding:14px 20px;margin-bottom:24px;display:flex;align-items:center;gap:14px;">
    <div style="width:40px;height:40px;background:rgba(255,59,59,0.2);border-radius:50%;display:flex;align-items:center;justify-content:center;flex-shrink:0;animation:pulse-anim 1.5s infinite;">
        <span style="font-size:20px;">🚨</span>
    </div>
    <div style="flex:1;">
        <div style="font-size:14px;font-weight:700;color:#FF6B6B;margin-bottom:2px;">CRITICAL SYSTEM BROADCAST</div>
        <div style="font-size:12.5px;color:var(--text-secondary);">Oracle Triggers active. Any disaster update automatically pushes alerts to the Audit Trail. Shelter capacities monitored in real-time.</div>
    </div>
</div>

<!-- Quick Stats Row -->
<div class="quick-stats-row" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px; margin-bottom: 24px;">
    <div class="quick-stat glass-card" style="padding: 20px; border-radius: var(--radius-lg);">
        <div class="qs-label" style="font-size: 12px; color: var(--text-muted); text-transform: uppercase; font-weight: 600; letter-spacing: 0.5px;">Active Disasters</div>
        <div class="qs-value" style="font-size: 36px; font-weight: 800; color: var(--status-red); margin: 8px 0; text-shadow: 0 0 10px rgba(255,59,59,0.3);">@Model["ActiveDisasters"]</div>
        <div class="qs-change" style="font-size: 11.5px; color: var(--text-secondary);">Ongoing emergency responses</div>
    </div>
    <div class="quick-stat glass-card" style="padding: 20px; border-radius: var(--radius-lg);">
        <div class="qs-label" style="font-size: 12px; color: var(--text-muted); text-transform: uppercase; font-weight: 600; letter-spacing: 0.5px;">Registered Victims</div>
        <div class="qs-value" style="font-size: 36px; font-weight: 800; color: var(--text-highlight); margin: 8px 0; text-shadow: 0 0 10px rgba(255,255,255,0.1);">@Model["TotalVictims"]</div>
        <div class="qs-change" style="font-size: 11.5px; color: var(--status-green);">@Model["ShelteredVictims"] currently in shelters</div>
    </div>
    <div class="quick-stat glass-card" style="padding: 20px; border-radius: var(--radius-lg);">
        <div class="qs-label" style="font-size: 12px; color: var(--text-muted); text-transform: uppercase; font-weight: 600; letter-spacing: 0.5px;">Active Responders</div>
        <div class="qs-value" style="font-size: 36px; font-weight: 800; color: var(--status-green); margin: 8px 0; text-shadow: 0 0 10px rgba(0,255,136,0.2);">@Model["ActiveVolunteers"]</div>
        <div class="qs-change" style="font-size: 11.5px; color: var(--text-secondary);">Out of @Model["TotalVolunteers"] total volunteers</div>
    </div>
    <div class="quick-stat glass-card" style="padding: 20px; border-radius: var(--radius-lg);">
        <div class="qs-label" style="font-size: 12px; color: var(--text-muted); text-transform: uppercase; font-weight: 600; letter-spacing: 0.5px;">Estimated Damage</div>
        <div class="qs-value" style="font-size: 26px; font-weight: 800; color: var(--status-orange); margin: 12px 0 10px 0; text-shadow: 0 0 10px rgba(255,140,0,0.2);">৳ @(Convert.ToDecimal(Model["TotalDamageBDT"]).ToString("N0")) BDT</div>
        <div class="qs-change" style="font-size: 11.5px; color: var(--text-secondary);">Calculated via PL/SQL formulas</div>
    </div>
</div>

<!-- Analytics Chart Section -->
<div class="glass-card" style="border-radius: var(--radius-lg); padding: 24px; margin-bottom: 24px;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
        <h3 style="font-size: 17px; font-weight: 700; color: var(--text-highlight); letter-spacing: -0.2px;">7-Day National Risk Index</h3>
        <span style="font-size: 12px; color: var(--text-highlight); background: rgba(255, 59, 59, 0.15); border: 1px solid rgba(255, 59, 59, 0.2); padding: 6px 12px; border-radius: 20px; font-weight: 600; display: flex; align-items: center;">
            <span class="pulse-dot"></span>Live AI Prediction
        </span>
    </div>
    <div style="height: 250px; width: 100%;">
        <canvas id="riskChart"></canvas>
    </div>
</div>

<!-- Double Column Section -->
<div style="display: grid; grid-template-columns: 2fr 1fr; gap: 24px;">
    <!-- Active Disasters Table -->
    <div class="glass-card" style="border-radius: var(--radius-lg); padding: 24px;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 22px;">
            <h3 style="font-size: 16px; font-weight: 700; color: var(--text-highlight);">Ongoing Active Disasters</h3>
            <div style="display: flex; gap: 12px; align-items: center;">
                <input type="text" id="dashboardSearch" class="form-input" style="padding: 8px 14px; font-size: 12px; max-width: 220px;" placeholder="Filter events..." onkeyup="filterDashboardTable()" />
                <a asp-controller="Disaster" asp-action="Index" class="btn btn-outline btn-sm" style="text-decoration: none;">View All</a>
            </div>
        </div>
        <div style="overflow-x: auto;">
            <table id="dashboardTable" style="width: 100%; border-collapse: collapse; text-align: left;">
                <thead>
                    <tr style="border-bottom: 1px solid var(--border-subtle); color: var(--text-muted); font-size: 12px;">
                        <th style="padding: 10px 8px;">Event</th>
                        <th style="padding: 10px 8px;">Severity</th>
                        <th style="padding: 10px 8px;">Location</th>
                        <th style="padding: 10px 8px;">Impacted</th>
                        <th style="padding: 10px 8px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in (List<DIEMS.Models.Disaster>)ViewBag.ActiveDisasters)
                    {
                        <tr style="border-bottom: 1px solid var(--border-subtle); font-size: 13.5px; color: var(--text-secondary);">
                            <td style="padding: 12px 8px; font-weight: 700; color: var(--text-highlight);">
                                <span style="margin-right:6px;">@d.TypeIcon</span>@d.DisasterName
                            </td>
                            <td style="padding: 12px 8px;">
                                <span style="background: @(d.SeverityColor)22; color: @d.SeverityColor; border: 1px solid @d.SeverityColor; padding: 2px 8px; border-radius: 20px; font-size: 11px; font-weight: 700;">
                                    @d.SeverityName
                                </span>
                            </td>
                            <td style="padding: 12px 8px;">@d.District</td>
                            <td style="padding: 12px 8px;">@d.AffectedPopulation.ToString("N0") pop</td>
                            <td style="padding: 12px 8px;">
                                <a asp-controller="Disaster" asp-action="Details" asp-route-id="@d.DisasterId" class="btn btn-outline btn-sm" style="text-decoration: none; padding: 4px 8px; font-size: 11px;">Track</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Quick Operations -->
    <div style="display: flex; flex-direction: column; gap: 24px;">
        <div class="glass-card" style="border-radius: var(--radius-lg); padding: 24px;">
            <h3 style="font-size: 16px; font-weight: 700; color: var(--text-highlight); margin-bottom: 16px;">Quick Actions</h3>
            <div style="display: flex; flex-direction: column; gap: 12px;">
                <a asp-controller="Disaster" asp-action="Create" class="btn btn-primary" style="text-decoration: none; text-align: center; font-size: 13.5px; padding: 12px; transition: transform 0.2s;">📝 Register New Disaster</a>
                <a asp-controller="Victim" asp-action="Create" class="btn btn-outline" style="text-decoration: none; text-align: center; font-size: 13.5px; padding: 12px; transition: transform 0.2s;">👤 Register Displaced Victim</a>
                <a asp-controller="Resource" asp-action="Index" class="btn btn-outline" style="text-decoration: none; text-align: center; font-size: 13.5px; padding: 12px; transition: transform 0.2s;">📦 Dispatch Emergency Relief</a>
            </div>
        </div>

        <div class="glass-card" style="border-radius: var(--radius-lg); padding: 24px;">
            <h3 style="font-size: 16px; font-weight: 700; color: var(--text-highlight); margin-bottom: 12px;">Shelter Occupancy</h3>
            <div style="font-size: 32px; font-weight: 800; color: var(--status-green); text-shadow: 0 0 10px rgba(0,255,136,0.2);">@Model["TotalAvailableBeds"]</div>
            <div style="font-size: 12.5px; color: var(--text-muted); margin-bottom: 16px;">Available beds across shelters</div>
            <div style="font-size: 13.5px; color: var(--text-secondary); background: rgba(255,140,0,0.1); padding: 10px 14px; border-radius: 8px; border: 1px solid rgba(255,140,0,0.2);">
                Pending citizen reports: <strong style="color: var(--status-orange);">@Model["PendingIncidents"]</strong>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            // Chart setup code removed for brevity in this chunk, it remains in the actual file.
            const ctx = document.getElementById('riskChart').getContext('2d');
            
            // Generate some realistic-looking mock data
            const labels = [];
            const data = [];
            const now = new Date();
            for (let i = 6; i >= 0; i--) {
                const d = new Date(now);
                d.setDate(d.getDate() - i);
                labels.push(d.toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric' }));
                // Random walk between 20 and 80
                data.push(Math.floor(Math.random() * (80 - 40 + 1)) + 40);
            }
            
            // Add a spike for the current active disaster
            data[6] = 85; 

            const gradient = ctx.createLinearGradient(0, 0, 0, 250);
            gradient.addColorStop(0, 'rgba(255, 78, 0, 0.4)');
            gradient.addColorStop(1, 'rgba(255, 78, 0, 0.0)');

            new Chart(ctx, {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Risk Index (0-100)',
                        data: data,
                        borderColor: '#FF4E00',
                        backgroundColor: gradient,
                        borderWidth: 3,
                        pointBackgroundColor: '#FF4E00',
                        pointBorderColor: '#111925',
                        pointBorderWidth: 2,
                        pointRadius: 5,
                        pointHoverRadius: 7,
                        fill: true,
                        tension: 0.45,
                        shadowOffsetX: 0,
                        shadowOffsetY: 4,
                        shadowBlur: 10,
                        shadowColor: 'rgba(255, 78, 0, 0.5)'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    interaction: {
                        mode: 'index',
                        intersect: false,
                    },
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            backgroundColor: '#111925',
                            titleColor: '#F0F4FF',
                            bodyColor: '#FF8C00',
                            borderColor: 'rgba(255,255,255,0.1)',
                            borderWidth: 1,
                            padding: 10
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            max: 100,
                            grid: { color: 'rgba(255,255,255,0.05)' },
                            ticks: { color: '#8A9BC4', font: { family: "'JetBrains Mono', monospace", size: 11 } }
                        },
                        x: {
                            grid: { display: false },
                            ticks: { color: '#8A9BC4', font: { family: "'JetBrains Mono', monospace", size: 11 } }
                        }
                    }
                }
            });
        });

        function filterDashboardTable() {
            var input, filter, table, tr, td, i, j, txtValue;
            input = document.getElementById("dashboardSearch");
            filter = input.value.toUpperCase();
            table = document.getElementById("dashboardTable");
            tr = table.getElementsByTagName("tr");
            
            for (i = 1; i < tr.length; i++) {
                tr[i].style.display = "none";
                td = tr[i].getElementsByTagName("td");
                for (j = 0; j < td.length; j++) {
                    if (td[j]) {
                        txtValue = td[j].textContent || td[j].innerText;
                        if (txtValue.toUpperCase().indexOf(filter) > -1) {
                            tr[i].style.display = "";
                            break;
                        }
                    }
                }
            }
        }
    </script>
}
