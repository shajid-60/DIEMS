@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login — DIEMS Command Center</title>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/global.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
</head>
<body class="login-page">

    <!-- Three.js Globe Canvas -->
    <canvas id="globe-canvas"></canvas>

    <!-- Particle Field -->
    <div class="particle-field" id="particle-field"></div>

    <!-- Alert Ticker -->
    <div class="alert-ticker">
        <div class="ticker-label">
            <span class="pulse-dot"></span>
            LIVE ALERTS
        </div>
        <div class="ticker-content">
            <span>🌊 Cyclone REMAL approaching coastal areas — Category 4 — ETA 6 hours &nbsp;&nbsp;&nbsp;|&nbsp;&nbsp;&nbsp;
                  🔥 Wildfire Active — Sylhet Forest Region — 2,400 acres affected &nbsp;&nbsp;&nbsp;|&nbsp;&nbsp;&nbsp;
                  🌍 Earthquake M5.8 detected — Chittagong Hill Tracts — Rescue teams deployed</span>
        </div>
    </div>

    <!-- Main Login Container -->
    <div class="login-wrapper">
        <!-- Left Panel -->
        <div class="login-left">
            <div class="brand-logo">
                <div class="logo-icon">
                    <svg viewBox="0 0 60 60" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <circle cx="30" cy="30" r="28" stroke="url(#grad1)" stroke-width="2"/>
                        <path d="M30 8 L30 52 M8 30 L52 30" stroke="url(#grad1)" stroke-width="1.5" stroke-dasharray="3,3"/>
                        <circle cx="30" cy="30" r="12" fill="none" stroke="#FF4E00" stroke-width="2"/>
                        <circle cx="30" cy="30" r="4" fill="#FF4E00"/>
                        <defs>
                            <linearGradient id="grad1" x1="0" y1="0" x2="60" y2="60" gradientUnits="userSpaceOnUse">
                                <stop offset="0%" stop-color="#FF4E00"/>
                                <stop offset="100%" stop-color="#FF8C00"/>
                            </linearGradient>
                        </defs>
                    </svg>
                </div>
                <div class="brand-text">
                    <span class="brand-acronym">DIEMS</span>
                    <span class="brand-full">Disaster Intelligence & Emergency Management</span>
                </div>
            </div>

            <div class="hero-content">
                <h1 class="hero-title">
                    <span class="title-line">Intelligent</span>
                    <span class="title-line accent">Disaster Response</span>
                    <span class="title-line">Command Center</span>
                </h1>
                <p class="hero-desc">
                    Real-time monitoring, AI-powered risk prediction, and coordinated emergency response — all in one unified platform for government agencies, NGOs, and first responders.
                </p>
                <div class="feature-tags">
                    <span class="tag">🛰️ Real-time Monitoring</span>
                    <span class="tag">📊 Analytics Dashboard</span>
                    <span class="tag">🚑 Resource Allocation</span>
                    <span class="tag">⚙️ Oracle DB Integrated</span>
                </div>
            </div>
        </div>

        <!-- Right Panel - Login Form -->
        <div class="login-right">
            <div class="login-card">
                <div class="card-header">
                    <h2>Secure Access Portal</h2>
                    <p>Authentication required for system entry</p>
                </div>

                @if (ViewBag.Error != null)
                {
                    <div style="background: rgba(255, 59, 59, 0.15); border: 1px solid rgba(255, 59, 59, 0.3); padding: 12px; border-radius: 8px; color: #FF4E00; margin-bottom: 20px; font-size: 13.5px; text-align: center;">
                        ⚠️ @ViewBag.Error
                    </div>
                }

                <form class="login-form" method="post" asp-controller="Home" asp-action="Login">
                    <div class="form-group">
                        <label for="login-id">Username</label>
                        <div class="input-wrapper">
                            <svg class="input-icon" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="8" r="4" stroke="currentColor" stroke-width="2"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7" stroke="currentColor" stroke-width="2"/></svg>
                            <input type="text" id="login-id" name="username" placeholder="Enter your username (e.g. admin)" required />
                        </div>
                    </div>

                    <div class="form-group">
                        <label for="login-pass">Password</label>
                        <div class="input-wrapper">
                            <svg class="input-icon" viewBox="0 0 24 24" fill="none"><rect x="3" y="11" width="18" height="11" rx="2" stroke="currentColor" stroke-width="2"/><path d="M7 11V7a5 5 0 0110 0v4" stroke="currentColor" stroke-width="2"/></svg>
                            <input type="password" id="login-pass" name="password" placeholder="Enter password" required />
                        </div>
                    </div>

                    <button type="submit" class="login-btn" id="login-submit" style="margin-top: 15px;">
                        <span class="btn-text">Access System</span>
                        <svg class="btn-arrow" viewBox="0 0 24 24" fill="none"><path d="M5 12h14M12 5l7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                    </button>
                </form>

                <div class="divider">
                    <span>public access</span>
                </div>

                <div class="emergency-access">
                    <a asp-controller="Report" asp-action="Create" class="emergency-btn" style="text-align: center; text-decoration: none; display: flex; align-items: center; justify-content: center; gap: 8px;">
                        <span>🚨</span> Report Emergency
                    </a>
                </div>
            </div>

            <!-- System Status -->
            <div class="system-status">
                <div class="status-item">
                    <div class="status-dot green"></div>
                    <span>Database Online</span>
                </div>
                <div class="status-item">
                    <div class="status-dot green"></div>
                    <span>Oracle 24.3.1 Connected</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r134/three.min.js"></script>
    <script src="~/js/globe.js" asp-append-version="true"></script>
    <script src="~/js/login.js" asp-append-version="true"></script>
</body>
</html>
