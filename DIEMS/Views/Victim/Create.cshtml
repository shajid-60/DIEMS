@model DIEMS.Models.Victim
@{
    ViewData["Title"] = "Register Displaced Victim";
}

<div style="margin-bottom: 24px;">
    <a asp-action="Index" style="color:var(--text-muted); font-size:13px; text-decoration:none;">← Back to Registry</a>
    <h1 style="font-size:24px; font-weight:800; color:var(--text-highlight); margin-top:8px;">Register Displaced Citizen</h1>
</div>

<div style="background:var(--bg-elevated); border:1px solid var(--border-subtle); border-radius:var(--radius-lg); padding:24px; max-width:800px;">
    <form method="post" asp-action="Create">
        
        <div class="form-group" style="margin-bottom:16px;">
            <label style="font-size:12px; font-weight:600; color:var(--text-highlight); display:block; margin-bottom:6px;">Full Name</label>
            <input type="text" name="FullName" required class="form-input" placeholder="e.g. Kalam Mia" />
        </div>

        <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px; margin-bottom:16px;">
            <div class="form-group">
                <label style="font-size:12px; font-weight:600; color:var(--text-highlight); display:block; margin-bottom:6px;">National ID (NID)</label>
                <input type="text" name="Nid" class="form-input" placeholder="17-digit or 10-digit number" />
            </div>
            <div class="form-group">
                <label style="font-size:12px; font-weight:600; color:var(--text-highlight); display:block; margin-bottom:6px;">Date of Birth</label>
                <input type="date" name="DateOfBirth" class="form-input" />
            </div>
        </div>

        <div style="display:grid; grid-template-columns:repeat(3, 1fr); gap:16px; margin-bottom:16px;">
            <div class="form-group">
                <label style="font-size:12px; font-weight:600; color:var(--text-highlight); display:block; margin-bottom:6px;">Age</label>
                <input type="number" name="Age" class="form-input" min="0" value="30" />
            </div>
            <div class="form-group">
                <label style="font-size:12px; font-weight:600; color:var(--text-highlight); display:block; margin-bottom:6px;">Gender</label>
                <select name="Gender" class="form-select">
                    <option value="M">Male</option>
                    <option value="F">Female</option>
                    <option value="O">Other</option>
                </select>
            </div>
            <div class="form-group">
                <label style="font-size:12px; font-weight:600; color:var(--text-highlight); display:block; margin-bottom:6px;">Blood Group</label>
                <select name="BloodGroup" class="form-select">
                    <option value="O+">O+</option>
                    <option value="O-">O-</option>
                    <option value="A+">A+</option>
                    <option value="A-">A-</option>
                    <option value="B+">B+</option>
                    <option value="B-">B-</option>
                    <option value="AB+">AB+</option>
                    <option value="AB-">AB-</option>
                </select>
            </div>
        </div>

        <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px; margin-bottom:16px;">
            <div class="form-group">
                <label style="font-size:12px; font-weight:600; color:var(--text-highlight); display:block; margin-bottom:6px;">Primary Phone</label>
                <input type="text" name="Phone" class="form-input" placeholder="e.g. +88017..." />
            </div>
            <div class="form-group">
                <label style="font-size:12px; font-weight:600; color:var(--text-highlight); display:block; margin-bottom:6px;">Emergency Contact</label>
                <input type="text" name="EmergencyContact" class="form-input" placeholder="e.g. Relative phone" />
            </div>
        </div>

        <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px; margin-bottom:16px;">
            <div class="form-group">
                <label style="font-size:12px; font-weight:600; color:var(--text-highlight); display:block; margin-bottom:6px;">Home Address</label>
                <input type="text" name="Address" class="form-input" placeholder="e.g. Village name" />
            </div>
            <div class="form-group">
                <label style="font-size:12px; font-weight:600; color:var(--text-highlight); display:block; margin-bottom:6px;">District</label>
                <input type="text" name="District" required class="form-input" placeholder="e.g. Sylhet" />
            </div>
        </div>

        <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px; margin-bottom:16px;">
            <div class="form-group">
                <label style="font-size:12px; font-weight:600; color:var(--text-highlight); display:block; margin-bottom:6px;">Linked Disaster Event</label>
                <select name="DisasterId" required class="form-select">
                    @foreach (var d in (List<DIEMS.Models.Disaster>)ViewBag.Disasters)
                    {
                        <option value="@d.DisasterId">@d.DisasterName</option>
                    }
                </select>
            </div>
            <div class="form-group">
                <label style="font-size:12px; font-weight:600; color:var(--text-highlight); display:block; margin-bottom:6px;">Medical Condition</label>
                <select name="MedicalCondition" class="form-select">
                    <option value="Stable">Stable</option>
                    <option value="Minor">Minor</option>
                    <option value="Moderate">Moderate</option>
                    <option value="Critical">Critical</option>
                </select>
            </div>
        </div>

        <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px; margin-bottom:16px;">
            <div class="form-group">
                <label style="font-size:12px; font-weight:600; color:var(--text-highlight); display:block; margin-bottom:6px;">Status</label>
                <select name="Status" class="form-select">
                    <option value="Displaced">Displaced (Needs shelter)</option>
                    <option value="Sheltered">Sheltered (Pre-assigned)</option>
                    <option value="Medical">Medical (In hospital)</option>
                    <option value="Missing">Missing</option>
                </select>
            </div>
            <div class="form-group" style="display: flex; align-items: center; margin-top: 25px;">
                <label class="checkbox-label" style="display: flex; align-items: center; gap: 8px; color: var(--text-highlight); font-weight: 600; font-size: 13.5px; cursor: pointer;">
                    <input type="checkbox" name="autoAllocate" value="true" checked style="width: 18px; height: 18px;" />
                    Auto-Allocate Shelter via PL/SQL Trigger/Procedure
                </label>
            </div>
        </div>

        <div class="form-group" style="margin-bottom:20px;">
            <label style="font-size:12px; font-weight:600; color:var(--text-highlight); display:block; margin-bottom:6px;">Notes / Special Needs</label>
            <textarea name="Notes" class="form-textarea" placeholder="e.g. Requires wheel chair, diabetic diet..."></textarea>
        </div>

        <button type="submit" class="btn btn-primary" style="padding:10px 24px; font-size:14px;">Register & Process</button>
    </form>
</div>
