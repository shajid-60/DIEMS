@model DIEMS.Models.Victim
@{
    ViewData["Title"] = "Edit Displaced Victim";
}

<div style="margin-bottom: 24px;">
    <a asp-action="Index" style="color:var(--text-muted); font-size:13px; text-decoration:none;">← Back to Registry</a>
    <h1 style="font-size:24px; font-weight:800; color:var(--text-highlight); margin-top:8px;">Edit Displaced Citizen: @Model.FullName</h1>
</div>

<div style="background:var(--bg-elevated); border:1px solid var(--border-subtle); border-radius:var(--radius-lg); padding:24px; max-width:800px;">
    <form method="post" asp-action="Edit">
        
        <div asp-validation-summary="All" class="text-danger" style="color:var(--status-red); font-size:13px; margin-bottom:16px;"></div>
        
        <input type="hidden" name="VictimId" value="@Model.VictimId" />

        <div class="form-group" style="margin-bottom:16px;">
            <label style="font-size:12px; font-weight:600; color:var(--text-highlight); display:block; margin-bottom:6px;">Full Name</label>
            <input type="text" name="FullName" value="@Model.FullName" required class="form-input" placeholder="e.g. Kalam Mia" />
        </div>

        <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px; margin-bottom:16px;">
            <div class="form-group">
                <label style="font-size:12px; font-weight:600; color:var(--text-highlight); display:block; margin-bottom:6px;">National ID (NID)</label>
                <input type="text" name="Nid" value="@Model.Nid" class="form-input" placeholder="17-digit or 10-digit number" />
            </div>
            <div class="form-group">
                <label style="font-size:12px; font-weight:600; color:var(--text-highlight); display:block; margin-bottom:6px;">Date of Birth</label>
                <input type="date" name="DateOfBirth" value="@(Model.DateOfBirth?.ToString("yyyy-MM-dd"))" class="form-input" />
            </div>
        </div>

        <div style="display:grid; grid-template-columns:repeat(3, 1fr); gap:16px; margin-bottom:16px;">
            <div class="form-group">
                <label style="font-size:12px; font-weight:600; color:var(--text-highlight); display:block; margin-bottom:6px;">Age</label>
                <input type="number" name="Age" value="@Model.Age" class="form-input" min="0" />
            </div>
            <div class="form-group">
                <label style="font-size:12px; font-weight:600; color:var(--text-highlight); display:block; margin-bottom:6px;">Gender</label>
                <select name="Gender" class="form-select">
                    <option value="M" selected="@(Model.Gender == "M")">Male</option>
                    <option value="F" selected="@(Model.Gender == "F")">Female</option>
                    <option value="O" selected="@(Model.Gender == "O")">Other</option>
                </select>
            </div>
            <div class="form-group">
                <label style="font-size:12px; font-weight:600; color:var(--text-highlight); display:block; margin-bottom:6px;">Blood Group</label>
                <select name="BloodGroup" class="form-select">
                    <option value="O+" selected="@(Model.BloodGroup == "O+")">O+</option>
                    <option value="O-" selected="@(Model.BloodGroup == "O-")">O-</option>
                    <option value="A+" selected="@(Model.BloodGroup == "A+")">A+</option>
                    <option value="A-" selected="@(Model.BloodGroup == "A-")">A-</option>
                    <option value="B+" selected="@(Model.BloodGroup == "B+")">B+</option>
                    <option value="B-" selected="@(Model.BloodGroup == "B-")">B-</option>
                    <option value="AB+" selected="@(Model.BloodGroup == "AB+")">AB+</option>
                    <option value="AB-" selected="@(Model.BloodGroup == "AB-")">AB-</option>
                </select>
            </div>
        </div>

        <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px; margin-bottom:16px;">
            <div class="form-group">
                <label style="font-size:12px; font-weight:600; color:var(--text-highlight); display:block; margin-bottom:6px;">Primary Phone</label>
                <input type="text" name="Phone" value="@Model.Phone" class="form-input" placeholder="e.g. +88017..." />
            </div>
            <div class="form-group">
                <label style="font-size:12px; font-weight:600; color:var(--text-highlight); display:block; margin-bottom:6px;">Emergency Contact</label>
                <input type="text" name="EmergencyContact" value="@Model.EmergencyContact" class="form-input" placeholder="e.g. Relative phone" />
            </div>
        </div>

        <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px; margin-bottom:16px;">
            <div class="form-group">
                <label style="font-size:12px; font-weight:600; color:var(--text-highlight); display:block; margin-bottom:6px;">Home Address</label>
                <input type="text" name="Address" value="@Model.Address" class="form-input" placeholder="e.g. Village name" />
            </div>
            <div class="form-group">
                <label style="font-size:12px; font-weight:600; color:var(--text-highlight); display:block; margin-bottom:6px;">District</label>
                <input type="text" name="District" value="@Model.District" required class="form-input" placeholder="e.g. Sylhet" />
            </div>
        </div>

        <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px; margin-bottom:16px;">
            <div class="form-group">
                <label style="font-size:12px; font-weight:600; color:var(--text-highlight); display:block; margin-bottom:6px;">Linked Disaster Event</label>
                <select name="DisasterId" required class="form-select">
                    @foreach (var d in (List<DIEMS.Models.Disaster>)ViewBag.Disasters)
                    {
                        <option value="@d.DisasterId" selected="@(Model.DisasterId == d.DisasterId)">@d.DisasterName</option>
                    }
                </select>
            </div>
            <div class="form-group">
                <label style="font-size:12px; font-weight:600; color:var(--text-highlight); display:block; margin-bottom:6px;">Medical Condition</label>
                <select name="MedicalCondition" class="form-select">
                    <option value="Stable" selected="@(Model.MedicalCondition == "Stable")">Stable</option>
                    <option value="Minor" selected="@(Model.MedicalCondition == "Minor")">Minor</option>
                    <option value="Moderate" selected="@(Model.MedicalCondition == "Moderate")">Moderate</option>
                    <option value="Critical" selected="@(Model.MedicalCondition == "Critical")">Critical</option>
                </select>
            </div>
        </div>

        <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px; margin-bottom:16px;">
            <div class="form-group">
                <label style="font-size:12px; font-weight:600; color:var(--text-highlight); display:block; margin-bottom:6px;">Status</label>
                <select name="Status" class="form-select">
                    <option value="Displaced" selected="@(Model.Status == "Displaced")">Displaced (Needs shelter)</option>
                    <option value="Sheltered" selected="@(Model.Status == "Sheltered")">Sheltered (Pre-assigned)</option>
                    <option value="Medical" selected="@(Model.Status == "Medical")">Medical (In hospital)</option>
                    <option value="Missing" selected="@(Model.Status == "Missing")">Missing</option>
                </select>
            </div>
            
            <div class="form-group">
                <label style="font-size:12px; font-weight:600; color:var(--text-highlight); display:block; margin-bottom:6px;">Linked Shelter</label>
                <select name="ShelterId" class="form-select">
                    <option value="">-- None --</option>
                    @foreach (var s in (List<DIEMS.Models.Shelter>)ViewBag.Shelters)
                    {
                        <option value="@s.ShelterId" selected="@(Model.ShelterId == s.ShelterId)">@s.ShelterName</option>
                    }
                </select>
            </div>
        </div>

        <div class="form-group" style="margin-bottom:20px;">
            <label style="font-size:12px; font-weight:600; color:var(--text-highlight); display:block; margin-bottom:6px;">Notes / Special Needs</label>
            <textarea name="Notes" class="form-textarea" placeholder="e.g. Requires wheel chair, diabetic diet...">@Model.Notes</textarea>
        </div>

        <button type="submit" class="btn btn-primary" style="padding:10px 24px; font-size:14px;">Update Record</button>
    </form>
</div>
