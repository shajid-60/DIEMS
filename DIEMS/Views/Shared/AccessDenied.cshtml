@{
    ViewData["Title"] = "Access Denied";
    var role = Context.Session.GetString("Role") ?? "Unknown";
}

<div style="display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:60vh;text-align:center;padding:40px;">
    <div style="width:100px;height:100px;background:rgba(255,59,59,0.15);border-radius:50%;display:flex;align-items:center;justify-content:center;margin-bottom:24px;border:2px solid rgba(255,59,59,0.3);animation:pulse-anim 2s infinite;">
        <svg viewBox="0 0 24 24" fill="none" style="width:48px;height:48px;">
            <path d="M12 22C17.5228 22 22 17.5228 22 12C22 6.47715 17.5228 2 12 2C6.47715 2 2 6.47715 2 12C2 17.5228 6.47715 22 12 22Z" stroke="#FF3B3B" stroke-width="2"/>
            <path d="M4.93 4.93L19.07 19.07" stroke="#FF3B3B" stroke-width="2" stroke-linecap="round"/>
        </svg>
    </div>
    
    <h1 style="font-size:48px;font-weight:900;color:var(--status-red);margin-bottom:8px;letter-spacing:-1px;">403</h1>
    <h2 style="font-size:20px;font-weight:700;color:var(--text-highlight);margin-bottom:12px;">Access Denied</h2>
    <p style="font-size:14px;color:var(--text-secondary);max-width:480px;margin-bottom:8px;">
        Your role <span style="background:rgba(255,78,0,0.2);color:var(--primary);padding:2px 10px;border-radius:20px;font-weight:700;font-size:13px;border:1px solid rgba(255,78,0,0.3);">@role</span> does not have permission to access this resource.
    </p>
    <p style="font-size:12.5px;color:var(--text-muted);max-width:480px;margin-bottom:32px;">
        If you believe this is an error, contact your system administrator. Only authorized personnel with the appropriate clearance level may access restricted modules.
    </p>
    
    <a asp-controller="Home" asp-action="Dashboard" class="btn btn-primary" style="text-decoration:none;padding:12px 32px;font-size:14px;font-weight:700;">
        ← Return to Dashboard
    </a>
</div>

<style>
    @@keyframes pulse-anim {
        0% { box-shadow: 0 0 0 0 rgba(255,59,59,0.4); }
        70% { box-shadow: 0 0 0 15px rgba(255,59,59,0); }
        100% { box-shadow: 0 0 0 0 rgba(255,59,59,0); }
    }
</style>
