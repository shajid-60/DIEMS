@using Microsoft.AspNetCore.Http
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="DIEMS Dashboard — Real-time disaster monitoring, analytics, and emergency coordination." />
    <title>@ViewData["Title"] — DIEMS</title>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet" />
    
    <!-- Stylesheets -->
    <link rel="stylesheet" href="~/css/global.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
    
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
</head>
<body>
    <!-- Alert Ticker -->
    <div class="alert-ticker">
        <div class="ticker-label"><span class="pulse-dot"></span> LIVE ALERTS</div>
        <div class="ticker-content">
            <span>🌊 Cyclone REMAL — Category 4 — Coastal evacuation in progress &nbsp;|&nbsp;
                  🔥 Wildfire — Sylhet Division — 3 fire brigades deployed &nbsp;|&nbsp;
                  🏥 Medical emergency — Dhaka General Hospital — Blood O+ critical &nbsp;|&nbsp;
                  🌍 Aftershock M4.2 — Chittagong — Search & rescue ongoing &nbsp;|&nbsp;
                  💧 Flash Flood — Sunamganj District — 12,000 displaced</span>
        </div>
    </div>

    <div class="app-layout">
        <!-- Sidebar Navigation -->
        <aside class="sidebar" id="sidebar">
            <div class="sidebar-brand">
                <svg class="sidebar-logo" viewBox="0 0 60 60" fill="none">
                    <circle cx="30" cy="30" r="28" stroke="url(#sg1)" stroke-width="2"/>
                    <path d="M30 10 L30 50 M10 30 L50 30" stroke="url(#sg1)" stroke-width="1.5" stroke-dasharray="3,3"/>
                    <circle cx="30" cy="30" r="10" fill="none" stroke="#FF4E00" stroke-width="2"/>
                    <circle cx="30" cy="30" r="3" fill="#FF4E00"/>
                    <defs>
                        <linearGradient id="sg1" x1="0" y1="0" x2="60" y2="60" gradientUnits="userSpaceOnUse">
                            <stop offset="0%" stop-color="#FF4E00"/>
                            <stop offset="100%" stop-color="#FF8C00"/>
                        </linearGradient>
                    </defs>
                </svg>
                <div class="sidebar-brand-text">
                    <span class="sidebar-acronym">DIEMS</span>
                    <span class="sidebar-tagline">Disaster Intelligence &<br/>Emergency Management</span>
                </div>
            </div>

            <nav class="sidebar-nav">
                <span class="nav-section-title">Command Center</span>

                <a asp-controller="Home" asp-action="Dashboard" class="nav-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Home" && ViewContext.RouteData.Values["Action"]?.ToString() == "Dashboard" ? "active" : "")">
                    <svg viewBox="0 0 24 24" fill="none"><rect x="3" y="3" width="7" height="7" rx="1" stroke="currentColor" stroke-width="2"/><rect x="14" y="3" width="7" height="7" rx="1" stroke="currentColor" stroke-width="2"/><rect x="3" y="14" width="7" height="7" rx="1" stroke="currentColor" stroke-width="2"/><rect x="14" y="14" width="7" height="7" rx="1" stroke="currentColor" stroke-width="2"/></svg>
                    Dashboard
                </a>

                <a asp-controller="Disaster" asp-action="Index" class="nav-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Disaster" ? "active" : "")">
                    <svg viewBox="0 0 24 24" fill="none"><path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z" stroke="currentColor" stroke-width="2"/><path d="M12 9v4M12 17h.01" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                    Disaster Database
                </a>

                <a asp-controller="Victim" asp-action="Index" class="nav-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Victim" ? "active" : "")">
                    <svg viewBox="0 0 24 24" fill="none"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2" stroke="currentColor" stroke-width="2"/><circle cx="9" cy="7" r="4" stroke="currentColor" stroke-width="2"/><path d="M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75" stroke="currentColor" stroke-width="2"/></svg>
                    Victim Management
                </a>

                <a asp-controller="Resource" asp-action="Index" class="nav-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Resource" ? "active" : "")">
                    <svg viewBox="0 0 24 24" fill="none"><path d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z" stroke="currentColor" stroke-width="2"/><path d="M3.27 6.96L12 12.01l8.73-5.05M12 22.08V12" stroke="currentColor" stroke-width="2"/></svg>
                    Resource Inventory
                </a>

                <a asp-controller="Shelter" asp-action="Index" class="nav-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Shelter" ? "active" : "")">
                    <svg viewBox="0 0 24 24" fill="none"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z" stroke="currentColor" stroke-width="2"/><polyline points="9 22 9 12 15 12 15 22" stroke="currentColor" stroke-width="2"/></svg>
                    Shelter Management
                </a>

                <span class="nav-section-title">Healthcare</span>

                <a asp-controller="Hospital" asp-action="Index" class="nav-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Hospital" ? "active" : "")">
                    <svg viewBox="0 0 24 24" fill="none"><path d="M22 12h-4l-3 9L9 3l-3 9H2" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    Hospitals & Medical
                </a>

                <span class="nav-section-title">Field Operations</span>

                <a asp-controller="Volunteer" asp-action="Index" class="nav-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Volunteer" ? "active" : "")">
                    <svg viewBox="0 0 24 24" fill="none"><path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z" stroke="currentColor" stroke-width="2"/></svg>
                    Volunteers
                </a>

                <a asp-controller="Report" asp-action="Index" class="nav-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Report" ? "active" : "")">
                    <svg viewBox="0 0 24 24" fill="none"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z" stroke="currentColor" stroke-width="2"/><polyline points="14 2 14 8 20 8" stroke="currentColor" stroke-width="2"/><line x1="16" y1="13" x2="8" y2="13" stroke="currentColor" stroke-width="2"/><line x1="16" y1="17" x2="8" y2="17" stroke="currentColor" stroke-width="2"/><line x1="10" y1="9" x2="8" y2="9" stroke="currentColor" stroke-width="2"/></svg>
                    Incident Reports
                </a>

                <span class="nav-section-title">Intelligence</span>

                <a asp-controller="Analytics" asp-action="Index" class="nav-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Analytics" ? "active" : "")">
                    <svg viewBox="0 0 24 24" fill="none"><line x1="18" y1="20" x2="18" y2="10" stroke="currentColor" stroke-width="2"/><line x1="12" y1="20" x2="12" y2="4"  stroke="currentColor" stroke-width="2"/><line x1="6"  y1="20" x2="6"  y2="14" stroke="currentColor" stroke-width="2"/></svg>
                    Risk Analytics
                </a>
            </nav>

            <!-- Sidebar User Profile Footer -->
            <div class="sidebar-footer">
                <div class="user-profile-mini" style="position: relative;">
                    <div class="user-avatar" style="background: var(--primary); color: white; display: flex; align-items: center; justify-content: center; font-weight: 700;">
                        @(Context.Session.GetString("Username")?.Substring(0, Math.Min(2, Context.Session.GetString("Username")?.Length ?? 2))?.ToUpper() ?? "US")
                    </div>
                    <div class="user-info-mini">
                        <div class="user-name-mini" style="font-weight: 700;">@Context.Session.GetString("FullName")</div>
                        <div class="user-role-mini" style="font-size: 11px; color: var(--text-muted);">@Context.Session.GetString("Role")</div>
                    </div>
                    <a asp-controller="Home" asp-action="Logout" title="Logout" style="margin-left: auto; color: var(--status-red); display: flex; align-items: center;">
                        <svg viewBox="0 0 24 24" fill="none" style="width:18px;height:18px;"><path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 01-2-2h4M16 17l5-5-5-5M21 12H9" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </a>
                </div>
            </div>
        </aside>

        <!-- Main Content Area -->
        <main class="main-content">
            <!-- Topbar Header -->
            <header class="topbar">
                <div style="display:flex;align-items:center;gap:16px;">
                    <div>
                        <h2 style="font-size:17px;font-weight:700; color: var(--text-highlight);">DIEMS National Command Center</h2>
                        <p style="font-size:12px;color:var(--text-muted);">Connected to Oracle Database 24.3.1</p>
                    </div>
                </div>

                <div style="display:flex;align-items:center;gap:12px;">
                    <!-- Clock -->
                    <div style="font-family:var(--font-mono);font-size:13px;color:var(--text-secondary);background:var(--bg-elevated);padding:8px 14px;border-radius:var(--radius-md);border:1px solid var(--border-subtle);">
                        <span id="live-clock">00:00:00</span>
                    </div>
                </div>
            </header>

            <!-- Page Content rendering -->
            <div class="page-content">
                @RenderBody()
            </div>
        </main>
    </div>

    <!-- Live Clock Script -->
    <script>
        function updateClock() {
            const now = new Date();
            const timeStr = now.toTimeString().split(' ')[0];
            const clockEl = document.getElementById('live-clock');
            if (clockEl) {
                clockEl.textContent = timeStr;
            }
        }
        setInterval(updateClock, 1000);
        updateClock();
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
