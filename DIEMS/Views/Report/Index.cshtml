@model List<DIEMS.Models.IncidentReport>
@{
    ViewData["Title"] = "Incident Reports";
    var auditLogs = (List<DIEMS.Models.AuditLog>)ViewBag.AuditLogs;
}

<div style="margin-bottom:24px;">
    <h1 style="font-size:24px; font-weight:800; color:var(--text-highlight);">Incident Reports & Audit Trails</h1>
    <p style="font-size:13px; color:var(--text-muted);">Citizen emergency reports and system-wide database change auditing</p>
</div>

<!-- Double Column Section -->
<div style="display: grid; grid-template-columns: 3fr 2fr; gap: 24px;">
    <!-- Incident Reports List -->
    <div style="background: var(--bg-elevated); border: 1px solid var(--border-subtle); border-radius: var(--radius-lg); padding: 20px;">
        <h3 style="font-size: 16px; font-weight: 700; color: var(--text-highlight); margin-bottom: 18px;">Citizen Reports</h3>
        <div style="overflow-x: auto;">
            <table style="width: 100%; border-collapse: collapse; text-align: left;">
                <thead>
                    <tr style="border-bottom: 1px solid var(--border-subtle); color: var(--text-muted); font-size: 12px;">
                        <th style="padding: 10px 8px;">Reporter</th>
                        <th style="padding: 10px 8px;">Type</th>
                        <th style="padding: 10px 8px;">Location</th>
                        <th style="padding: 10px 8px;">Date</th>
                        <th style="padding: 10px 8px;">Severity</th>
                        <th style="padding: 10px 8px;">Status</th>
                        <th style="padding: 10px 8px; text-align:right;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model)
                    {
                        <tr style="border-bottom: 1px solid var(--border-subtle); font-size: 13px; color: var(--text-secondary);">
                            <td style="padding: 12px 8px; font-weight: 700; color: var(--text-highlight);">
                                @r.ReporterName
                                <div style="font-size:11px; color:var(--text-muted); font-weight:normal;">@r.ReporterPhone</div>
                            </td>
                            <td style="padding: 12px 8px;">@r.IncidentType</td>
                            <td style="padding: 12px 8px;">@r.Location, @r.District</td>
                            <td style="padding: 12px 8px; font-size: 12px;">@r.ReportedAt.ToString("yyyy-MM-dd HH:mm")</td>
                            <td style="padding: 12px 8px;">
                                <span style="color:@(r.SeverityLevel == "Immediate" || r.SeverityLevel == "High" ? "var(--status-red)" : "var(--text-secondary)"); font-weight:700;">
                                    @r.SeverityLevel
                                </span>
                            </td>
                            <td style="padding: 12px 8px; font-weight:700; color:@(r.Status == "Resolved" ? "var(--status-green)" : "var(--status-orange)");">
                                @r.Status
                            </td>
                            <td style="padding: 12px 8px; text-align:right;">
                                <a asp-action="Details" asp-route-id="@r.ReportId" class="btn btn-outline btn-sm" style="text-decoration:none; padding:4px 8px; font-size:11px;">Details</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Security & Data Audit Trail (AUDIT_LOG populated by Triggers!) -->
    <div style="background: var(--bg-elevated); border: 1px solid var(--border-subtle); border-radius: var(--radius-lg); padding: 20px;">
        <h3 style="font-size: 16px; font-weight: 700; color: var(--text-highlight); margin-bottom: 14px;">Database Audit Logs (PL/SQL Triggers Output)</h3>
        <div style="display:flex; flex-direction:column; gap:12px; max-height:500px; overflow-y:auto;">
            @foreach (var log in auditLogs)
            {
                <div style="background:var(--bg-card); border:1px solid rgba(255, 78, 0, 0.15); padding:12px; border-radius:var(--radius-md);">
                    <div style="display:flex; justify-content:space-between; margin-bottom:4px;">
                        <span style="font-size:11px; background:var(--bg-elevated); padding:2px 6px; border-radius:4px; font-weight:700; color:var(--status-orange);">
                            @log.Operation on @log.TableName
                        </span>
                        <span style="font-size:11px; color:var(--text-muted); font-family:var(--font-mono);">
                            @log.ChangedAt.ToString("HH:mm:ss")
                        </span>
                    </div>
                    <div style="font-size:12.5px; color:var(--text-highlight); margin-bottom:4px;">
                        Column: <strong>@log.ColumnName</strong>
                    </div>
                    <div style="font-size:11px; color:var(--text-secondary); background:rgba(0,0,0,0.2); padding:4px 8px; border-radius:4px; margin-bottom:4px;">
                        Old: @log.OldValue <br/>
                        New: @log.NewValue
                    </div>
                    <div style="display:flex; justify-content:space-between; font-size:10.5px; color:var(--text-muted);">
                        <span>By: <strong>@log.ChangedBy</strong> (@log.Module)</span>
                        <span>@log.Notes</span>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
