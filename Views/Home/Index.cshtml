@{
    ViewData["Title"] = "Dashboard";
}

<div class="row">

    ```
    <div class="col-md-3 mb-4">
        <div class="card-box bg-blue">
            <h5>Total Disasters</h5>
            <h1>25</h1>
        </div>
    </div>

    <div class="col-md-3 mb-4">
        <div class="card-box bg-green">
            <h5>Total Victims</h5>
            <h1>540</h1>
        </div>
    </div>

    <div class="col-md-3 mb-4">
        <div class="card-box bg-red">
            <h5>Shelters</h5>
            <h1>32</h1>
        </div>
    </div>

    <div class="col-md-3 mb-4">
        <div class="card-box bg-orange">
            <h5>Volunteers</h5>
            <h1>87</h1>
        </div>
    </div>
    ```

</div>

<div class="card shadow">
    <div class="card-header">
        Recent Disaster Updates
    </div>

    ```
    <div class="card-body">

        <table class="table table-bordered">

            <thead>
                <tr>
                    <th>ID</th>
                    <th>Disaster Type</th>
                    <th>Location</th>
                    <th>Status</th>
                </tr>
            </thead>

            <tbody>
                <tr>
                    <td>1</td>
                    <td>Flood</td>
                    <td>Khulna</td>
                    <td>Active</td>
                </tr>

                <tr>
                    <td>2</td>
                    <td>Cyclone</td>
                    <td>Barisal</td>
                    <td>Monitoring</td>
                </tr>

                <tr>
                    <td>3</td>
                    <td>Fire</td>
                    <td>Dhaka</td>
                    <td>Resolved</td>
                </tr>
            </tbody>

        </table>

    </div>
    ```

</div>
