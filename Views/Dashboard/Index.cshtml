@{
    ViewData["Title"] = "DIEMS Dashboard";
}

<div class="container-fluid">

    <div class="row">

        <!-- Sidebar -->

        <div class="col-md-2 bg-dark text-white vh-100">

            <h3 class="mt-3 text-center">
                DIEMS
            </h3>

            <hr>

            <ul class="nav flex-column">

                <li class="nav-item">
                    <a class="nav-link text-white" href="#">
                        Dashboard
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link text-white" href="#">
                        Disasters
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link text-white" href="#">
                        Victims
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link text-white" href="#">
                        Shelters
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link text-white" href="#">
                        Resources
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link text-white" href="#">
                        Volunteers
                    </a>
                </li>

            </ul>

        </div>

        <!-- Main Content -->

        <div class="col-md-10">

            <div class="p-4">

                <h2>
                    Disaster Information &
                    Emergency Management System
                </h2>

                <hr>

                <div class="row mt-4">

                    <div class="col-md-3">

                        <div class="card bg-danger text-white">

                            <div class="card-body">

                                <h5>Total Disasters</h5>

                                <h1>15</h1>

                            </div>

                        </div>

                    </div>

                    <div class="col-md-3">

                        <div class="card bg-primary text-white">

                            <div class="card-body">

                                <h5>Victims</h5>

                                <h1>542</h1>

                            </div>

                        </div>

                    </div>

                    <div class="col-md-3">

                        <div class="card bg-success text-white">

                            <div class="card-body">

                                <h5>Shelters</h5>

                                <h1>24</h1>

                            </div>

                        </div>

                    </div>

                    <div class="col-md-3">

                        <div class="card bg-warning text-dark">

                            <div class="card-body">

                                <h5>Volunteers</h5>

                                <h1>86</h1>

                            </div>

                        </div>

                    </div>

                </div>

                <div class="card mt-5">

                    <div class="card-header">

                        Recent Disaster Updates

                    </div>

                    <div class="card-body">

                        <table class="table table-bordered">

                            <thead>

                                <tr>
                                    <th>ID</th>
                                    <th>Disaster</th>
                                    <th>Location</th>
                                    <th>Status</th>
                                </tr>

                            </thead>

                            <tbody>

                                <tr>
                                    <td>1</td>
                                    <td>Flood</td>
                                    <td>Khulna</td>
                                    <td>Active</td>
                                </tr>

                                <tr>
                                    <td>2</td>
                                    <td>Cyclone</td>
                                    <td>Barisal</td>
                                    <td>Resolved</td>
                                </tr>

                                <tr>
                                    <td>3</td>
                                    <td>Fire</td>
                                    <td>Dhaka</td>
                                    <td>Active</td>
                                </tr>

                            </tbody>

                        </table>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>